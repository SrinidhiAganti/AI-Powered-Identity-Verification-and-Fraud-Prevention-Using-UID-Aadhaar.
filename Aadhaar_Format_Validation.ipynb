      "source": [
        "import re\n",
        "\n",
        "def validate_aadhaar(text):\n",
        "    pattern = r\"\\b\\d{4}\\s\\d{4}\\s\\d{4}\\b\"\n",
        "    match = re.search(pattern, text)\n",
        "    return match.group() if match else \"Invalid Aadhaar\"\n"
      ]
    }
  ]
}