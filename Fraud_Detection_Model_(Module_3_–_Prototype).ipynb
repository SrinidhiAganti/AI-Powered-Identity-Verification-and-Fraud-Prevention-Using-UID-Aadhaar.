      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "class TamperNet(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.fc = nn.Linear(512, 2)\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.fc(x)\n"
      ]
    }
  ]
